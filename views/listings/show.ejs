<% layout('layouts/boilerplate') %>
  <div class="row mb-3 offset-md-2">
    <div class="col-8 offset-md-2 mt-3">
      <h3>Listing details</h3>
      <br>
    </div>
    <div class="listing-card card col-md-6 offset-md-2 mb-5">
      <img src="<%= listing.image.url %>" class="card-img-top show-image" alt="listing image" />
      <div class="card-body mt-3">
        <h5 class="card-text"><b>
            <%= listing.title %>
          </b></h5>
        <p class="card-text">
          <%= listing.description %>
        </p>
        <p class="card-text">
          <strong>Price:</strong> ₹<%= listing.price.toLocaleString("en-IN") %>
        </p>
        <div class="row">
          <div class="col-10">
            <a href="/listings/<%= listing._id %>/edit" class="btn col-3 btn-primary">Edit</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display: inline">
              <button type="submit" class="btn col-3 btn-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <hr>
    <div>
      <h4>Leave a review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mt-3 mb-3">
          <label for="rating" class="form-label">Rating:</label>
          <input type="range" id="rating" name="review[rating]" min="1" max="5">
          <div class="mt-3 mb-3">

            <label for="comment" class="form-label">Comments:</label>
            <textarea id="comment" name="review[comment]" rows="4" cols="50" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add some commant for review</div>
          </div>
          </div>
        <button type="submit" class="btn btn-outline-dark">Submit Review</button>
      </form>
      <hr>
      <p><b>All reviews</b></p>
      <div class="row">

        <% for (let review of listing.reviews) { %>
          <div class="card col-5 ms-3 mb-3">
            <div class="card-body">
              <h5 class="card-title">demo man</h5>
              <p class="card-text"><%= review.comment %></p>
              <p class="card-text"><%= review.rating %>star</p>
            </div>
            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mb-3"> <button type="submit" class="btn btn-danger">Delete</button> </form>
          </div>
          <% } %>
        </div>
    </div>
  </div>